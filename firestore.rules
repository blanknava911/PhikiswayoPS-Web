rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isSchoolAdmin() {
      return isVerified() && (
        request.auth.token.email.lower() == 'blanknava205@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidNotice(data) {
      return data.title is string && data.title.size() >= 3 && data.title.size() <= 200 &&
             data.published_at is string && data.published_at.size() == 10 && data.published_at.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
             data.category is string && data.category in ['general', 'admissions', 'academic', 'events'] &&
             data.summary is string && data.summary.size() >= 5 && data.summary.size() <= 2000 &&
             data.audience is string && data.audience.size() >= 2 && data.audience.size() <= 100 &&
             data.pinned is bool &&
             data.published is bool &&
             (!('authorEmail' in data) || (data.authorEmail is string && data.authorEmail.size() <= 150));
    }

    function isValidEvent(data) {
      return data.title is string && data.title.size() >= 3 && data.title.size() <= 200 &&
             data.category is string && data.category in ['academic', 'sports', 'meetings'] &&
             data.category_label is string && data.category_label.size() >= 2 && data.category_label.size() <= 100 &&
             data.event_date is string && data.event_date.size() == 10 && data.event_date.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
             data.event_time is string && data.event_time.size() >= 2 && data.event_time.size() <= 50 &&
             data.location is string && data.location.size() >= 2 && data.location.size() <= 200 &&
             data.description is string && data.description.size() >= 5 && data.description.size() <= 3000 &&
             data.published is bool &&
             (!('image_url' in data) || (data.image_url is string && data.image_url.size() <= 1000)) &&
             (!('authorEmail' in data) || (data.authorEmail is string && data.authorEmail.size() <= 150));
    }

    // Notices collection
    match /notices/{noticeId} {
      allow get: if isValidId(noticeId) && (resource.data.published == true || isSchoolAdmin());
      allow list: if (resource.data.published == true || isSchoolAdmin());
      allow create: if isValidId(noticeId) && isSchoolAdmin() && isValidNotice(incoming());
      allow update: if isValidId(noticeId) && isSchoolAdmin() && isValidNotice(incoming());
      allow delete: if isValidId(noticeId) && isSchoolAdmin();
    }

    // Events collection
    match /events/{eventId} {
      allow get: if isValidId(eventId) && (resource.data.published == true || isSchoolAdmin());
      allow list: if (resource.data.published == true || isSchoolAdmin());
      allow create: if isValidId(eventId) && isSchoolAdmin() && isValidEvent(incoming());
      allow update: if isValidId(eventId) && isSchoolAdmin() && isValidEvent(incoming());
      allow delete: if isValidId(eventId) && isSchoolAdmin();
    }

    // Admins collection (lookup table)
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isSignedIn() && (request.auth.uid == adminId || isSchoolAdmin());
      allow list: if isSchoolAdmin();
      allow write: if isSchoolAdmin();
    }
  }
}
